# Copy to `.env.local` and fill in. All NEXT_PUBLIC_* vars are baked in at build time
# (set them in Netlify → Project configuration → Environment variables for deploys).

# Canonical production URL - no trailing slash
NEXT_PUBLIC_SITE_URL=https://dorset.affogato.xin

# Brand & SEO
NEXT_PUBLIC_BUSINESS_NAME=The Dorset
NEXT_PUBLIC_BRAND_WORD_PRIMARY=The
NEXT_PUBLIC_BRAND_WORD_SECONDARY=Dorset
NEXT_PUBLIC_TITLE_SUFFIX=New American Restaurant in New York
NEXT_PUBLIC_SITE_DESCRIPTION=Seasonal New American cooking inspired by local farms and the Atlantic coast in New York City.
NEXT_PUBLIC_SITE_KEYWORDS=The Dorset, New American restaurant NYC, Greenwich Village restaurant, seasonal dining New York, coastal cuisine NYC

# Contact
NEXT_PUBLIC_PHONE_E164=+8613371246106
NEXT_PUBLIC_PHONE_DISPLAY=13371246106
NEXT_PUBLIC_WHATSAPP_DIGITS=8613371246106
NEXT_PUBLIC_EMAIL_CONTACT=affogatocold@gmail.com

# Ordering (Square, Toast, etc.)
NEXT_PUBLIC_ORDER_URL=

# Address (also used in JSON-LD / geo meta)
NEXT_PUBLIC_ADDRESS_LINE=7 Carmine Street
NEXT_PUBLIC_ADDRESS_CITY=New York
NEXT_PUBLIC_ADDRESS_REGION=NY
NEXT_PUBLIC_ADDRESS_STATE_NAME=New York
NEXT_PUBLIC_ADDRESS_POSTAL=10014
NEXT_PUBLIC_ADDRESS_COUNTRY=US
NEXT_PUBLIC_ADDRESS_DISPLAY=7 Carmine Street, New York, NY 10014
NEXT_PUBLIC_MAPS_URL=https://www.google.com/maps/search/?api=1&query=7%20Carmine%20Street%2C%20New%20York%2C%20NY%2010014

# Geo (decimals)
NEXT_PUBLIC_GEO_LAT=
NEXT_PUBLIC_GEO_LNG=
NEXT_PUBLIC_GEO_REGION_META=US-NY
NEXT_PUBLIC_GEO_PLACENAME=New York
NEXT_PUBLIC_AREA_SERVED_CITY=New York
NEXT_PUBLIC_AREA_SERVED_METRO=New York metropolitan area

# Hours (semicolon-separated schema.org values)
NEXT_PUBLIC_OPENING_HOURS_SCHEMA=Mo-We 17:00-23:00;Th 17:00-01:00;Fr 17:00-02:00;Sa 11:00-02:00;Su 11:00-23:00
NEXT_PUBLIC_HOURS_REGULAR=Monday-Wednesday|5pm-11pm;Thursday|5pm-1am;Friday|5pm-2am;Saturday|11am-2am;Sunday|11am-11pm
NEXT_PUBLIC_HOURS_BRUNCH=Saturday|11am-3:30pm;Sunday|11am-3:30pm

# Cuisine types (comma-separated, for schema.org)
NEXT_PUBLIC_SERVES_CUISINE=New American
NEXT_PUBLIC_PAYMENT_METHODS=Cash, Credit Card

# Social profile URLs (leave blank until the real profile exists; blank links are hidden)
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_TWITTER_CREATOR=

# Developer portfolio links (personal Instagram is optional and hidden when blank)
NEXT_PUBLIC_DEVELOPER_NAME=邓钰鸣
NEXT_PUBLIC_DEVELOPER_GITHUB=https://github.com/affogato2025
NEXT_PUBLIC_DEVELOPER_INSTAGRAM=https://www.instagram.com/affogatocold__/
NEXT_PUBLIC_DEVELOPER_PORTFOLIO=https://affogato.xin

# Theme (browser chrome / PWA)
NEXT_PUBLIC_THEME_COLOR=#050505

# Optional: Google Search Console (HTML tag content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: show aggregate rating in JSON-LD (omit both to hide)
NEXT_PUBLIC_SCHEMA_RATING_VALUE=
NEXT_PUBLIC_SCHEMA_REVIEW_COUNT=

# Maps API (used in layout)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
